{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff format *)",
      "Bash(uv run ruff format)",
      "Bash(uv run python -m ty check *)",
      "Bash(uv run python -m ty check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git show)",
      "Bash(python scripts/package_source.py)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv sync *)",
      "Bash(uv sync)",
      "Bash(uv lock *)",
      "Bash(uv lock)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm install)",
      "Bash(pnpm remove *)",
      "Bash(uv run alembic upgrade *)",
      "Bash(uv run alembic downgrade *)",
      "Bash(git commit --amend *)",
      "Bash(git commit --amend)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(backend/tests/fixtures/_local/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ]
  }
}
