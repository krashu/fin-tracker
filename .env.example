# Copy to .env (gitignored) and fill in values when needed.

# ── Docker self-host (make up / make up-proxy / make dev) ─────────────────────
# Requires Docker Compose >= 2.24 (env_file long-form, depends_on.condition, and
# the proxy overlay's `!reset` tag). The compose files DEFAULT DATABASE_URL to the
# mounted /data volume and set CORS_ALLOWED_ORIGINS (proxy variant) for you — but a
# DATABASE_URL set below overrides that default (e.g. to point at Postgres).
# The one value you MUST set for any self-host stack is a real JWT_SECRET (below);
# the app boots with the loud dev placeholder otherwise, which is fine only for
# throwaway local http. Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Proxy stack only — host port Caddy publishes (default 8080). If you change it,
# the proxy overlay keeps CORS_ALLOWED_ORIGINS in sync automatically.
# PROXY_PORT=8080

# ── Demo login (matters MOST on plain http, incl. every LAN stack) ────────────
# The demo account (demo@fin-tracker.local / demofintracker) is stamped onto the
# fixed-UUID user by migration 0017 on EVERY stack — SEED_DEMO_ON_STARTUP gates the demo
# DATASET, not the demo ACCOUNT — and its password is published in this repo. So the
# login is REFUSED unless you set this. Leave it unset for any stack another device can
# reach (`make up` / `make up-proxy` publish ports; API_HOST=0.0.0.0 does the same
# natively): that account is the same row an upgraded install's REAL data hangs off, and
# POST /auth/change-password refuses it, so it can't be re-secured from the app.
# Set it to true only on a throwaway dev box. `make dev` turns it on for you.
# It has no effect when COOKIE_SECURE=true — a published password never rides a
# hardened deploy (the backend logs an advisory at boot if you set both).
# DEMO_LOGIN_ENABLED=true

# Optional override. Unset = each stack's own default (Docker: the /data volume; raw
# `uv run main.py`: ./data under backend/). A Docker SQLite path needs FOUR slashes
# (absolute), as shown; or point at Postgres, etc.
# DATABASE_URL=sqlite:////data/fin-tracker.db

# Backend API server bind config, read by backend/main.py (`uv run main.py`).
# These are the BACKEND host/port — the Next.js frontend has its own config.
# Defaults are production-safe: 127.0.0.1 / 8000 / reload off. Set
# API_HOST=0.0.0.0 to expose on the LAN (v1.5 hosting); set API_RELOAD=true for
# local hot-reload. `make backend` forces --reload regardless.
# API_HOST=127.0.0.1
# API_PORT=8000
# API_RELOAD=false

# Log renderer. Default is the human-readable console renderer; set to `json`
# for structured logs (forward-compatible with v2 hosted deployment). Read by
# backend/app/core/log_config.py.
# LOG_FORMAT=console

# Log level for app logs and the bridged uvicorn loggers. Does NOT reach
# SQLAlchemy (it pins its own logger to WARNING at import time). Default INFO;
# unknown values fall back to INFO.
# LOG_LEVEL=info

# V1 single-user UUID. Must match the row seeded by
# backend/alembic/versions/0001_initial_schema.py. Override only if you
# re-seed with a different UUID. The app lifespan handler refuses to
# boot on mismatch.
# V1_USER_ID=00000000-0000-0000-0000-000000000001

# (v0.6.5) NAV / price snapshot (PRD §F7) — public price feeds, no keys.
# Defaults work out of the box; override only to point at a mirror or tune the
# per-request timeout. Read by backend/app/core/config.py.
# AMFI_NAVALL_URL=https://portal.amfiindia.com/spages/NAVAll.txt
# YAHOO_QUOTE_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
# NAV_FETCH_TIMEOUT_SECS=5.0
# mfapi.in NAV *history* for the benchmark backfill (PRD §F8 view 5). Seed-time only.
# MFAPI_BASE_URL=https://api.mfapi.in/mf

# Parser real-PDF tests — passwords for the gitignored statements in
# backend/tests/fixtures/_local/. Loaded by backend/tests/parsers/conftest.py
# (only fills keys not already in the environment, so shell exports win).
# AXIS_TEST_PWD=
# ICICI_TEST_PWD=

# ── Hosted deploy (anything not plain http on localhost) ─────────────────────
# The shipped stacks are plain http on localhost, so these all default safely for
# local use. If you put a TLS terminator in front, COOKIE_SECURE is the one you must
# set: it defaults False, and the JWT-placeholder guard in core/config.py only fires
# when cookie_secure is ALREADY true — so leaving it unset means auth cookies are
# issued without the Secure flag and nothing warns you.
# COOKIE_SECURE=true
# Lax (default) is right for same-site. Only widen if the frontend is on a different
# site from the API, and understand the CSRF trade before you do.
# COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to call the API. The proxy overlay sets this
# for you; set it by hand for any other topology.
# CORS_ALLOWED_ORIGINS=https://finance.example.com
# Only enable behind a proxy you control that overwrites X-Forwarded-For — otherwise
# the rate limiter can be evaded with a spoofed header.
# RATE_LIMIT_TRUST_PROXY=true
