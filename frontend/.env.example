# Frontend Environment Variables Template
# Copy to .env.local (gitignored) for local development overrides.

# Backend API base URL.
# - Local dev (pnpm dev on port 3000 -> FastAPI on port 8000): http://localhost:8000/api/v1
# - Unified full-stack deployment (FastAPI app.frontend()): /api/v1
# - Split hosting (e.g. Next.js on Vercel + FastAPI on Cloud): https://<your-backend>.fastapicloud.dev/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
